# Backend Environment Variables Template

# 1. Server Configuration
PORT=5000

# 2. Security (JWT)
# Generate a secure string for your JSON Web Tokens
JWT_SECRET=your_super_secret_jwt_key

# 3. Frontend Integration
# Comma-separated list of allowed origins (CORS)
# Include localhost for dev, and your Vercel domains for prod
FRONTEND_URL=https://rent-a-fellow.vercel.app,https://prssn-frontend.vercel.app,https://www.prsnn.com,https://prsnn.com,http://localhost:3000

# 4. Database (MongoDB)
# Your MongoDB connection string
MONGO_DB_URI=mongodb+srv://username:password@cluster.mongodb.net/yourDatabase

# 5. Cloudinary (Image Uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# 6. Email Configuration (Resend)
# Used for OTPs and notifications
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=noreply@yourdomain.com

# 7. Razorpay (Payments)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# 8. Environment separation
# Cloudinary folder for uploads. Production leaves the default; the testing
# service sets CLOUDINARY_FOLDER=prsnn-verification-testing so test uploads
# never mix with real ID documents in the same cloud.
CLOUDINARY_FOLDER=prsnn-verification

# ── Testing service (Render: prssn-backend-testing, branch: testing) ──
# Same variables, different values. The ones that MUST differ:
#   MONGO_DB_URI      → same cluster, different database name, e.g. .../userData_testing
#   FRONTEND_URL      → https://testing.prsnn.com,<vercel branch alias>,http://localhost:3000
#   RAZORPAY_KEY_ID   → rzp_test_...   (never live keys on testing)
#   RAZORPAY_KEY_SECRET
#   CLOUDINARY_FOLDER → prsnn-verification-testing
#   JWT_SECRET        → a different secret, so a testing token is useless in production
